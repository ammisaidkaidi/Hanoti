# Copy to .env and fill in local values. Never commit .env.
#
# The CLI reads the environment only; it never loads .env by itself.
# Start it with Node's own loader instead:
#
#   node --env-file=.env dist/cli.js setup
#
# Application credentials: must target the hanouti database. The URL policy
# rejects any other database name, so a typo can never point a migration or
# an inspection at the wrong target.
DATABASE_URL=postgresql://hanouti_app:CHANGE_ME@localhost:5432/hanouti

# Provisioning credentials: CREATEDB on a maintenance database such as
# postgres. Required by `setup` to create hanouti when it is absent, and
# optional for `seed --privileges`. Keep this separate from DATABASE_URL.
ADMIN_DATABASE_URL=postgresql://hanouti_provisioner:CHANGE_ME@localhost:5432/postgres

# Role that owns a newly created hanouti database. Defaults to the role in
# DATABASE_URL, which lets the application identity apply migrations without
# superuser rights. The provisioning role must be a member of this role.
#HANOTI_DB_OWNER=hanouti_app

# Location of hanouti/data in the paired checkout. Defaults to
# ../hanoti-structure/hanoti/data relative to this package.
#HANOTI_DATA_DIR=/srv/hanoti/hanoti-structure/hanoti/data

# Location of the checked fixtures used by `verify`. Defaults to
# ../hanoti-structure/.test/data/fixtures relative to this package.
#HANOTI_FIXTURES_DIR=/srv/hanoti/hanoti-structure/.test/data/fixtures

# Migration/seed ledger location. Defaults to public.migration_ledger.
#HANOTI_LEDGER_SCHEMA=public
#HANOTI_LEDGER_TABLE=migration_ledger

# Connection timeout in milliseconds for every helper and command. Default 10000.
#HANOTI_CONNECT_TIMEOUT_MS=10000
