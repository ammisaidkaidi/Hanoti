# ─────────────────────────────────────────────────────────────
# Dependency trees and virtualenvs
# Third-party code, platform-specific binaries, tens of MB.
# Reproducible from package.json / package-lock.json / requirements.txt.
# ─────────────────────────────────────────────────────────────
node_modules/
pyenv/
.venv/
venv/

# ─────────────────────────────────────────────────────────────
# Generated output — the compiled hanoti-db package and scratch dirs
# ─────────────────────────────────────────────────────────────
**/dist/
**/build/
**/coverage/
**/.tmp/
**/*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Python bytecode and local output
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.log
.cache/
